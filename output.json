{
  "name": "issue_bundle",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "gate",
      "requirements",
      "feature_matrix",
      "story",
      "dev_tasks",
      "qa",
      "scrum_master",
      "non_blocking_recommendations"
    ],
    "properties": {
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "primary_domain",
          "primary_intent",
          "persona",
          "core_objects",
          "key_verbs",
          "explicit_constraints",
          "excluded_topics",
          "assumptions",
          "open_questions"
        ],
        "properties": {
          "primary_domain": {
            "type": "string"
          },
          "primary_intent": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "core_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_verbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explicit_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded_topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "requirements": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text",
            "relevance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^R[0-9]+$"
            },
            "text": {
              "type": "string"
            },
            "relevance": {
              "type": "string"
            }
          }
        }
      },
      "feature_matrix": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filters",
          "sorts",
          "views",
          "edge_cases",
          "pagination_notes"
        ],
        "properties": {
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sorts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edge_cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pagination_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "story": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "persona",
          "user_story",
          "problem_statement",
          "in_scope",
          "out_of_scope",
          "acceptance_criteria",
          "nfrs",
          "definition_of_done"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "user_story": {
            "type": "string"
          },
          "problem_statement": {
            "type": "string"
          },
          "in_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "gherkin",
                "mapped_requirements",
                "relevance"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC[0-9]+$"
                },
                "gherkin": {
                  "type": "string"
                },
                "mapped_requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^R[0-9]+$"
                  }
                },
                "relevance": {
                  "type": "string"
                }
              }
            }
          },
          "nfrs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "dev_tasks": {
        "type": "array",
        "minItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "title",
            "mapped_requirements",
            "relevance",
            "details",
            "subtasks",
            "dependencies"
          ],
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "feature",
                "cross_cutting"
              ]
            },
            "title": {
              "type": "string"
            },
            "mapped_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^R[0-9]+$"
              }
            },
            "relevance": {
              "type": "string"
            },
            "details": {
              "type": "string"
            },
            "subtasks": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "qa": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_scenarios",
          "test_cases",
          "test_data",
          "automation_notes"
        ],
        "properties": {
          "test_scenarios": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "mapped_requirements",
                "relevance"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^TS[0-9]+$"
                },
                "text": {
                  "type": "string"
                },
                "mapped_requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^R[0-9]+$"
                  }
                },
                "relevance": {
                  "type": "string"
                }
              }
            }
          },
          "test_cases": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "steps",
                "expected",
                "mapped_requirements",
                "relevance"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^TC[0-9]+$"
                },
                "title": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "expected": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "mapped_requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^R[0-9]+$"
                  }
                },
                "relevance": {
                  "type": "string"
                }
              }
            }
          },
          "test_data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "automation_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "scrum_master": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_of_ready",
          "risks",
          "estimation_hint",
          "ceremony_notes"
        ],
        "properties": {
          "definition_of_ready": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimation_hint": {
            "type": "string"
          },
          "ceremony_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "non_blocking_recommendations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "why_optional"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "why_optional": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
